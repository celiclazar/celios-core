{
    "name": "celios/core",
    "description": "Core engine, multilingual routing, and administration platform for Celios CMS.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Lazar Celic",
            "email": "celiclazar@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "filament/filament": "^5.0|^4.0|^3.0",
        "awcodes/filament-curator": "^5.0",
        "bezhansalleh/filament-language-switch": "^4.3",
        "bezhansalleh/filament-shield": "^4.2",
        "spatie/laravel-translatable": "^6.0",
        "spatie/laravel-permission": "^6.0|^7.0",
        "spatie/laravel-activitylog": "^4.12",
        "spatie/laravel-medialibrary": "^10.0|^11.0",
        "laravel/sanctum": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Celios\\Core\\": "src/"
        },
        "files": [
            "src/Helpers/settings.php",
            "src/Helpers/pages.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Celios\\Core\\CeliosServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
